{
  "type": "object",
  "properties": {
    "kind": {
      "const": "simulation"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "write_set": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      }
    },
    "behavior": {
      "enum": [
        "success",
        "hang",
        "exit",
        "cancel",
        "malformed",
        "overflow"
      ]
    },
    "rework_failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "model_policy_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}@[1-9][0-9]{0,5}$"
    }
  },
  "required": [
    "kind",
    "base_sha"
  ],
  "additionalProperties": false
}
