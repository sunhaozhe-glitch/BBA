{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "koishi/contracts/types.gen.ts",
    "koishi/contracts/type-smoke.ts"
  ]
}
