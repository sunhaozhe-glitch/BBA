{
  "TaskState": {
    "type": "string",
    "enum": [
      "DRAFT",
      "VALIDATING",
      "READY",
      "RUNNING",
      "WAITING_EXTERNAL",
      "BLOCKED",
      "VERIFYING",
      "PAUSING",
      "PAUSED",
      "CANCELLING",
      "CANCELLED",
      "SUCCEEDED",
      "PARTIAL",
      "FAILED"
    ],
    "description": "Task lifecycle state. WAITING_EXTERNAL, BLOCKED, PAUSING and RECONCILING-side work are not success; submitted/pending/unknown items retain their slot."
  },
  "ExecutionMode": {
    "type": "string",
    "enum": ["dry_run", "read_only", "live"],
    "default": "dry_run",
    "description": "Declared execution mode, default dry_run. This enum is a future-mode contract, not an authorization: live actions still require a valid approval and verified capabilities."
  },
  "Goal": {
    "type": "object",
    "additionalProperties": false,
    "required": ["metric", "count", "strict_target_cap", "require_final_membership_check"],
    "properties": {
      "metric": { "type": "string", "enum": ["new_unique_groups_for_account_pool"] },
      "count": { "type": "integer", "minimum": 1, "maximum": 10000 },
      "strict_target_cap": {
        "type": "boolean",
        "enum": [true],
        "description": "Strict acquisition always keeps confirmed plus still-possible targets inside the goal cap."
      },
      "require_final_membership_check": {
        "type": "boolean",
        "enum": [true],
        "description": "Final verification always re-checks authoritative membership evidence."
      }
    },
    "description": "Goal metric and strictness. This schema cannot prove the global count inequality; the service and database tests must enforce it."
  },
  "FixedCandidate": {
    "type": "object",
    "additionalProperties": false,
    "required": ["group_id", "source_ref"],
    "properties": {
      "group_id": { "$ref": "common.json#/QQId" },
      "source_ref": { "$ref": "common.json#/Id" }
    },
    "description": "One explicitly imported candidate. group_id is the identity; source_ref records provenance but never authorizes a search."
  },
  "CandidateSource": {
    "type": "object",
    "additionalProperties": false,
    "required": ["kind", "groups"],
    "properties": {
      "kind": {
        "type": "string",
        "enum": ["fixed"],
        "description": "The only strict acquire source. Keyword discovery is not an implicit source."
      },
      "groups": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5000,
        "uniqueItems": true,
        "items": { "$ref": "#/FixedCandidate" }
      }
    },
    "description": "Non-empty explicit candidate import. uniqueItems only rejects identical records; the service must also reject duplicate group_id values that differ only by source_ref."
  },
  "TaskLimits": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "max_candidates",
      "max_attempts_per_action",
      "max_total_external_attempts",
      "max_model_attempts"
    ],
    "properties": {
      "max_candidates": { "type": "integer", "minimum": 1, "maximum": 5000 },
      "max_search_pages_per_keyword": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Optional finite search budget for a later explicitly authorized provider. Its presence never authorizes keyword discovery."
      },
      "max_attempts_per_action": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "description": "Retry budget is accumulated per logical subtask and is not reset by changing account or execution."
      },
      "max_total_external_attempts": { "type": "integer", "minimum": 1, "maximum": 10000 },
      "max_model_attempts": { "type": "integer", "minimum": 0, "maximum": 10 }
    },
    "description": "Finite request limits. The schema bounds values but cannot enforce account quota or provider rate policy."
  },
  "CreateTaskRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "type",
      "title",
      "join_reason",
      "verification_message",
      "goal",
      "allowed_account_ids",
      "candidate_source",
      "deadline_at",
      "limits",
      "approval_ref",
      "submit"
    ],
    "properties": {
      "join_reason": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500,
        "description": "Operator-approved platform reason, exact bytes; empty string allowed. Member presence and approval binding remain required."
      },
      "verification_message": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500,
        "description": "Operator-approved platform answer, independent of reason; empty string allowed. Member presence and approval binding remain required."
      },
      "type": { "type": "string", "enum": ["group.acquire", "group.analyze", "chat", "customer.add_me", "customer.add_customer"] },
      "title": { "type": "string", "minLength": 1, "maxLength": 200 },
      "keywords": {
        "type": "array",
        "maxItems": 20,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": "Optional display/audit metadata only. It never authorizes keyword discovery or expands the fixed candidate source."
      },
      "goal": { "$ref": "#/Goal" },
      "allowed_account_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": { "$ref": "common.json#/Id" }
      },
      "candidate_source": { "$ref": "#/CandidateSource" },
      "execution_mode": { "$ref": "#/ExecutionMode" },
      "deadline_at": { "$ref": "common.json#/UTCDateTime" },
      "limits": { "$ref": "#/TaskLimits" },
      "approval_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128,
        "description": "Must be non-null for live mode. Cross-field approval scope is verified by the service, not by this schema."
      },
      "submit": {
        "type": "boolean",
        "description": "false keeps a draft; true requests validation. Acceptance does not mean external actions have started."
      }
    },
    "description": "Strict group.acquire creation request. candidate_source is required and must be a non-empty fixed import; there is no default keyword discovery. Account membership, workspace ownership, deadline policy and duplicate group_id semantics are service checks. QQ business type union extension: group.analyze, chat, customer.add_me and customer.add_customer are recognised, persisted and read back as drafts; only group.acquire has an executed chain, and submit of the other four types is refused fail-closed as CAPABILITY_UNAVAILABLE with no external writes (see docs/qq03-task-type-matrix.md)."
  },
  "OrchestrationMode": {
    "type": "string",
    "enum": ["legacy", "proposal"],
    "description": "Legacy uses the existing automatic scheduler. Proposal tasks only execute explicitly approved and materialized work items; mode changes require quiescence."
  },
  "Task": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "workspace_id",
      "type",
      "title",
      "state",
      "version",
      "scope_revision",
      "orchestration_mode",
      "authorization_revision",
      "execution_mode",
      "goal_count",
      "confirmed_unique_count",
      "reserved_target_count",
      "pending_external_count",
      "unknown_execution_count",
      "blocked_reason",
      "deadline_at",
      "created_at"
    ],
    "properties": {
      "id": { "$ref": "common.json#/Id" },
      "workspace_id": { "$ref": "common.json#/Id" },
      "type": { "type": "string", "enum": ["group.acquire", "group.analyze", "chat", "customer.add_me", "customer.add_customer"] },
      "title": { "type": "string", "minLength": 1, "maxLength": 200 },
      "state": { "$ref": "#/TaskState" },
      "version": { "type": "integer", "minimum": 1 },
      "scope_revision": { "type": "integer", "minimum": 1 },
      "orchestration_mode": { "$ref": "#/OrchestrationMode" },
      "authorization_revision": { "type": "integer", "minimum": 1 },
      "execution_mode": { "$ref": "#/ExecutionMode" },
      "goal_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
      "confirmed_unique_count": { "type": "integer", "minimum": 0 },
      "reserved_target_count": { "type": "integer", "minimum": 0 },
      "pending_external_count": { "type": "integer", "minimum": 0 },
      "unknown_execution_count": { "type": "integer", "minimum": 0 },
      "blocked_reason": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 1000
      },
      "deadline_at": { "$ref": "common.json#/UTCDateTime" },
      "created_at": { "$ref": "common.json#/UTCDateTime" }
    },
    "description": "Authoritative task projection. confirmed_unique_count is derived only from valid evidence-backed results; pending_external_count and unknown_execution_count never count as success and may overlap reserved_target_count. The schema cannot prove confirmed plus still-possible targets stay within goal_count; that is a service/database invariant."
  },
  "Subtask": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "task_id",
      "kind",
      "target_id",
      "discovery_key",
      "state",
      "assigned_account_id",
      "current_execution_id",
      "priority",
      "next_run_at",
      "attempt_count",
      "max_attempts",
      "last_error_code",
      "version",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "id": { "$ref": "common.json#/Id" },
      "task_id": { "$ref": "common.json#/Id" },
      "kind": { "type": "string", "enum": ["discover", "ensure_membership"] },
      "target_id": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "discovery_key": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "state": {
        "type": "string",
        "enum": [
          "QUEUED",
          "CLAIMED",
          "RUNNING",
          "WAITING_EXTERNAL",
          "RECONCILING",
          "RETRY_WAIT",
          "SUCCEEDED",
          "FAILED",
          "SKIPPED",
          "CANCELLED"
        ],
        "description": "WAITING_EXTERNAL and RECONCILING retain their goal slot; RETRY_WAIT requires proven no effect."
      },
      "assigned_account_id": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "current_execution_id": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
      "next_run_at": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
        "nullable": true
      },
      "attempt_count": { "type": "integer", "minimum": 0 },
      "max_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
      "last_error_code": {
        "type": "string",
        "nullable": true,
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      },
      "version": { "type": "integer", "minimum": 1 },
      "created_at": { "$ref": "common.json#/UTCDateTime" },
      "updated_at": { "$ref": "common.json#/UTCDateTime" }
    },
    "description": "Recoverable unit of business work. discover requires discovery_key; ensure_membership requires target_id. That conditional rule is a service invariant, not expressible in this OAS 3.0 object."
  },
  "SubtaskPage": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": { "$ref": "#/Subtask" }
      }
    },
    "description": "Subtask list payload. The cursor lives in envelope meta."
  },
  "Result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "task_id",
      "target_id",
      "account_id",
      "execution_id",
      "kind",
      "valid",
      "confirmed_at",
      "evidence_ref",
      "invalidated_at",
      "invalidation_reason",
      "version"
    ],
    "properties": {
      "id": { "$ref": "common.json#/Id" },
      "task_id": { "$ref": "common.json#/Id" },
      "target_id": { "$ref": "common.json#/Id" },
      "account_id": { "$ref": "common.json#/Id" },
      "execution_id": { "$ref": "common.json#/Id" },
      "kind": { "type": "string", "enum": ["group_joined"] },
      "valid": { "type": "boolean" },
      "confirmed_at": { "$ref": "common.json#/UTCDateTime" },
      "evidence_ref": { "$ref": "common.json#/Id" },
      "invalidated_at": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
        "nullable": true
      },
      "invalidation_reason": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 1000
      },
      "version": { "type": "integer", "minimum": 1 }
    },
    "description": "Evidence-backed membership result. A Result is never pending, submitted or unknown: those states belong to executions/observations and never create a result. Validity, baseline correlation and account/target ownership are service checks."
  },
  "ResultPage": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": { "$ref": "#/Result" }
      }
    },
    "description": "Result list payload. The cursor lives in envelope meta."
  },
  "TaskEvent": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "task_id",
      "seq",
      "type",
      "state_before",
      "state_after",
      "reason",
      "actor",
      "execution_id",
      "subtask_id",
      "target_id",
      "created_at"
    ],
    "properties": {
      "id": { "$ref": "common.json#/Id" },
      "task_id": { "$ref": "common.json#/Id" },
      "seq": { "$ref": "common.json#/DecimalSequence" },
      "type": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
      },
      "state_before": {
        "type": "string",
        "nullable": true,
        "enum": [
          "DRAFT",
          "VALIDATING",
          "READY",
          "RUNNING",
          "WAITING_EXTERNAL",
          "BLOCKED",
          "VERIFYING",
          "PAUSING",
          "PAUSED",
          "CANCELLING",
          "CANCELLED",
          "SUCCEEDED",
          "PARTIAL",
          "FAILED",
          null
        ]
      },
      "state_after": {
        "type": "string",
        "nullable": true,
        "enum": [
          "DRAFT",
          "VALIDATING",
          "READY",
          "RUNNING",
          "WAITING_EXTERNAL",
          "BLOCKED",
          "VERIFYING",
          "PAUSING",
          "PAUSED",
          "CANCELLING",
          "CANCELLED",
          "SUCCEEDED",
          "PARTIAL",
          "FAILED",
          null
        ]
      },
      "reason": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 1000
      },
      "actor": { "type": "string", "minLength": 1, "maxLength": 128 },
      "execution_id": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "subtask_id": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "target_id": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "created_at": { "$ref": "common.json#/UTCDateTime" }
    },
    "description": "Persistent task audit event. seq is a positive decimal string, preserving values beyond JavaScript's safe integer range; it increases monotonically per task. Cursor expiry is reported as CURSOR_EXPIRED and the client must reload the task snapshot."
  },
  "TaskEventPage": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": { "$ref": "#/TaskEvent" }
      }
    },
    "description": "Task event list payload. The cursor lives in envelope meta."
  },
  "TaskPage": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items"],
    "properties": {
      "items": { "type": "array", "items": { "$ref": "#/Task" } }
    },
    "description": "Task list payload. The cursor lives in envelope meta; every item contains current authoritative confirmed, pending and unknown counters."
  },
  "TaskPageEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "#/TaskPage" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "TaskEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "#/Task" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "ReceiptEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "common.json#/Receipt" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "AccountPageEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "common.json#/AccountPage" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "CapabilityPageEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "common.json#/CapabilityPage" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "SubtaskPageEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "#/SubtaskPage" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "ResultPageEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "#/ResultPage" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "TaskEventPageEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "#/TaskEventPage" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "HeartbeatEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "common.json#/HeartbeatReceipt" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  }
}
