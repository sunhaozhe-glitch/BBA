{
  "Action": {
    "type": "string",
    "enum": [
      "search_groups",
      "request_join",
      "observe_membership",
      "observe_join_request",
      "cancel_join_request",
      "send_text"
    ],
    "description": "Closed action set. No arbitrary URLs, shell commands or provider action names are accepted."
  },
  "EffectCertainty": {
    "type": "string",
    "enum": ["no_effect", "confirmed", "confirmed_submitted", "confirmed_rejected", "unknown"],
    "description": "What is known about an external effect. Only confirmed supports a membership result; confirmed_submitted means the request exists, not that it was approved."
  },
  "Disposition": {
    "type": "string",
    "enum": ["confirmed", "submitted", "rejected", "failed_no_effect", "unknown"],
    "description": "Observed operation disposition. Only confirmed may become business success evidence."
  },
  "ExecutionState": {
    "type": "string",
    "enum": ["CREATED", "ACCEPTED", "DISPATCHING", "OBSERVED", "UNKNOWN", "REJECTED_BEFORE_SEND"],
    "description": "Bridge ledger state. Missing in-memory state never authorizes rediscovery or replay; UNKNOWN remains unknown until authoritative reconciliation."
  },
  "JoinParams": {
    "type": "object",
    "additionalProperties": false,
    "required": ["reason", "verification_message"],
    "properties": {
      "reason": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500,
        "description": "Operator-approved native richMsg application reason."
      },
      "verification_message": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500,
        "description": "Operator-approved native applyMsg answer. Models may not freely rewrite it."
      }
    }
  },
  "SearchParams": {
    "type": "object",
    "additionalProperties": false,
    "required": ["keyword", "cursor", "limit"],
    "properties": {
      "keyword": { "type": "string", "minLength": 1, "maxLength": 64 },
      "cursor": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 512
      },
      "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
    },
    "description": "Bounded search request. The local NapCat plugin exposes no cursor; cursor remains part of the bridge capability for verified providers only."
  },
  "MembershipParams": {
    "type": "object",
    "additionalProperties": false,
    "required": ["group_id", "snapshot_scope"],
    "properties": {
      "group_id": {
        "type": "string",
        "nullable": true,
        "pattern": "^[1-9][0-9]*$"
      },
      "snapshot_scope": { "type": "string", "enum": ["target_group", "all_memberships"] }
    },
    "description": "Membership read scope. target_group requires group_id; all_memberships requires a complete list. That conditional rule is a service check."
  },
  "JoinObservationParams": {
    "type": "object",
    "additionalProperties": false,
    "required": ["request_ref"],
    "properties": {
      "request_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 256,
        "description": "Adapter request reference. Null means query by the outer target only."
      }
    }
  },
  "SendTextParams": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "conversation_kind",
      "conversation_id",
      "text",
      "trigger_ref",
      "segment_index",
      "segment_count",
      "text_digest"
    ],
    "properties": {
      "conversation_kind": { "type": "string", "enum": ["group", "private"] },
      "conversation_id": { "$ref": "common.json#/QQId" },
      "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
      "trigger_ref": { "$ref": "common.json#/Id" },
      "segment_index": { "type": "integer", "minimum": 0 },
      "segment_count": { "type": "integer", "minimum": 1, "maximum": 32 },
      "text_digest": { "$ref": "common.json#/Digest" }
    },
    "description": "Text-only send parameters. segment_index must be less than segment_count; the service enforces that conditional rule."
  },
  "ExecutionRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "execution_id",
      "task_id",
      "subtask_id",
      "workspace_id",
      "account_id",
      "runtime_id",
      "owner_epoch",
      "fence_token",
      "scope_revision",
      "action",
      "target",
      "params",
      "request_digest",
      "approval_ref",
      "deadline_at"
    ],
    "properties": {
      "execution_id": { "$ref": "common.json#/Id" },
      "task_id": { "$ref": "common.json#/Id" },
      "subtask_id": { "$ref": "common.json#/Id" },
      "workspace_id": { "$ref": "common.json#/Id" },
      "account_id": { "$ref": "common.json#/Id" },
      "runtime_id": { "$ref": "common.json#/Id" },
      "owner_epoch": { "$ref": "common.json#/DecimalSequence" },
      "fence_token": { "$ref": "common.json#/DecimalSequence" },
      "scope_revision": { "type": "integer", "minimum": 1 },
      "action": { "$ref": "#/Action" },
      "target": { "$ref": "common.json#/Target" },
      "params": {
        "oneOf": [
          { "$ref": "#/SearchParams" },
          { "$ref": "#/JoinParams" },
          { "$ref": "#/MembershipParams" },
          { "$ref": "#/JoinObservationParams" },
          { "$ref": "#/SendTextParams" }
        ]
      },
      "request_digest": { "$ref": "common.json#/Digest" },
      "approval_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "deadline_at": { "$ref": "common.json#/UTCDateTime" }
    },
    "oneOf": [
      {
        "required": ["action", "params"],
        "properties": {
          "action": { "type": "string", "enum": ["search_groups"] },
          "params": { "$ref": "#/SearchParams" }
        }
      },
      {
        "required": ["action", "params"],
        "properties": {
          "action": { "type": "string", "enum": ["request_join"] },
          "params": { "$ref": "#/JoinParams" }
        }
      },
      {
        "required": ["action", "params"],
        "properties": {
          "action": { "type": "string", "enum": ["observe_membership"] },
          "params": { "$ref": "#/MembershipParams" }
        }
      },
      {
        "required": ["action", "params"],
        "properties": {
          "action": { "type": "string", "enum": ["observe_join_request"] },
          "params": { "$ref": "#/JoinObservationParams" }
        }
      },
      {
        "required": ["action", "params"],
        "properties": {
          "action": { "type": "string", "enum": ["cancel_join_request"] },
          "params": { "$ref": "#/JoinObservationParams" }
        }
      },
      {
        "required": ["action", "params"],
        "properties": {
          "action": { "type": "string", "enum": ["send_text"] },
          "params": { "$ref": "#/SendTextParams" }
        }
      }
    ],
    "description": "Fixed bridge execution request. Each oneOf branch requires action and params and constrains action to one literal value, so action is the union discriminator; params is bound to that action. Search and send_text remain later-stage capabilities. request_digest is server-computed and never proves an external effect."
  },

  "Operation": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation_id",
      "state",
      "disposition",
      "effect_certainty",
      "external_request_ref",
      "observed_at",
      "evidence_ref",
      "error"
    ],
    "properties": {
      "operation_id": { "$ref": "common.json#/Id" },
      "state": { "$ref": "#/ExecutionState" },
      "disposition": {
        "type": "string",
        "nullable": true,
        "enum": ["confirmed", "submitted", "rejected", "failed_no_effect", "unknown", null]
      },
      "effect_certainty": { "$ref": "#/EffectCertainty" },
      "external_request_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 256
      },
      "observed_at": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
        "nullable": true
      },
      "evidence_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "error": {
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "required": ["code", "message", "retryable", "retry_after_ms", "details"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "retryable": { "type": "boolean" },
          "retry_after_ms": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 86400000
          },
          "details": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "anyOf": [
                { "type": "string", "maxLength": 512 },
                { "type": "integer" },
                { "type": "number" },
                { "type": "boolean" }
              ]
            }
          }
        }
      }
    },
    "oneOf": [
      {
        "required": ["state", "disposition", "effect_certainty"],
        "properties": {
          "state": { "type": "string", "enum": ["CREATED", "ACCEPTED", "REJECTED_BEFORE_SEND"] },
          "disposition": { "type": "string", "nullable": true, "enum": [null] },
          "effect_certainty": { "type": "string", "enum": ["no_effect"] },
          "observed_at": { "type": "string", "nullable": true, "enum": [null] },
          "evidence_ref": { "type": "string", "nullable": true, "enum": [null] }
        }
      },
      {
        "required": ["state", "disposition", "effect_certainty"],
        "properties": {
          "state": { "type": "string", "enum": ["DISPATCHING"] },
          "disposition": { "type": "string", "nullable": true, "enum": [null] },
          "effect_certainty": { "type": "string", "enum": ["unknown"] },
          "observed_at": { "type": "string", "nullable": true, "enum": [null] }
        }
      },
      {
        "required": ["state", "disposition", "effect_certainty"],
        "properties": {
          "state": { "type": "string", "enum": ["UNKNOWN"] },
          "disposition": { "type": "string", "enum": ["unknown"] },
          "effect_certainty": { "type": "string", "enum": ["unknown"] },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      },
      {
        "required": ["state", "disposition", "effect_certainty"],
        "properties": {
          "state": { "type": "string", "enum": ["OBSERVED"] },
          "disposition": { "type": "string", "enum": ["confirmed"] },
          "effect_certainty": { "type": "string", "enum": ["confirmed"] },
          "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      },
      {
        "required": ["state", "disposition", "effect_certainty"],
        "properties": {
          "state": { "type": "string", "enum": ["OBSERVED"] },
          "disposition": { "type": "string", "enum": ["submitted"] },
          "effect_certainty": { "type": "string", "enum": ["confirmed_submitted"] },
          "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      },
      {
        "required": ["state", "disposition", "effect_certainty"],
        "properties": {
          "state": { "type": "string", "enum": ["OBSERVED"] },
          "disposition": { "type": "string", "enum": ["rejected"] },
          "effect_certainty": { "type": "string", "enum": ["confirmed_rejected"] },
          "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      },
      {
        "required": ["state", "disposition", "effect_certainty"],
        "properties": {
          "state": { "type": "string", "enum": ["OBSERVED"] },
          "disposition": { "type": "string", "enum": ["failed_no_effect"] },
          "effect_certainty": { "type": "string", "enum": ["no_effect"] },
          "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      }
    ],
    "description": "Persistent operation ledger state. confirmed requires effect_certainty confirmed plus non-null evidence; submitted requires confirmed_submitted; unknown stays unknown. Accepted/dispatching states are not success."
  },
  "OperationEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "#/Operation" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "Observation": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "event_id",
      "workspace_id",
      "source_runtime_id",
      "source_account_id",
      "source_epoch",
      "source_sequence",
      "operation_id",
      "target",
      "kind",
      "payload",
      "observed_at",
      "evidence_ref"
    ],
    "properties": {
      "schema_version": { "type": "string", "enum": ["1"] },
      "event_id": { "$ref": "common.json#/Id" },
      "workspace_id": { "$ref": "common.json#/Id" },
      "source_runtime_id": { "$ref": "common.json#/Id" },
      "source_account_id": { "$ref": "common.json#/Id" },
      "source_epoch": { "$ref": "common.json#/DecimalSequence" },
      "source_sequence": { "$ref": "common.json#/DecimalSequence" },
      "operation_id": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128,
        "description": "May be null for passive membership events. A missing correlation is never invented."
      },
      "target": { "$ref": "common.json#/Target" },
      "kind": {
        "type": "string",
        "enum": ["membership.observed", "join.request.observed", "execution.observed"]
      },
      "payload": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "snapshot_complete"],
            "properties": {
              "state": { "type": "string", "enum": ["joined", "not_joined", "unknown"] },
              "snapshot_complete": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "authoritative", "request_ref"],
            "properties": {
              "state": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled", "unknown"] },
              "authoritative": { "type": "boolean" },
              "request_ref": {
                "type": "string",
                "nullable": true,
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "effect_certainty", "request_ref", "message_ref"],
            "properties": {
              "outcome": { "type": "string", "enum": ["submitted", "confirmed", "rejected", "failed_no_effect", "unknown"] },
              "effect_certainty": { "$ref": "#/EffectCertainty" },
              "request_ref": {
                "type": "string",
                "nullable": true,
                "minLength": 1,
                "maxLength": 256
              },
              "message_ref": {
                "type": "string",
                "nullable": true,
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        ]
      },
      "observed_at": { "$ref": "common.json#/UTCDateTime" },
      "evidence_ref": { "$ref": "common.json#/Id" }
    },
    "oneOf": [
      {
        "required": ["kind", "payload"],
        "properties": {
          "kind": { "type": "string", "enum": ["membership.observed"] },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "snapshot_complete"],
            "properties": {
              "state": { "type": "string", "enum": ["joined", "not_joined", "unknown"] },
              "snapshot_complete": { "type": "boolean" }
            }
          }
        }
      },
      {
        "required": ["kind", "payload"],
        "properties": {
          "kind": { "type": "string", "enum": ["join.request.observed"] },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "authoritative", "request_ref"],
            "properties": {
              "state": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled", "unknown"] },
              "authoritative": { "type": "boolean" },
              "request_ref": {
                "type": "string",
                "nullable": true,
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      },
      {
        "required": ["kind", "payload"],
        "properties": {
          "kind": { "type": "string", "enum": ["execution.observed"] },
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["outcome", "effect_certainty", "request_ref", "message_ref"],
                "properties": {
                  "outcome": { "type": "string", "enum": ["confirmed"] },
                  "effect_certainty": { "type": "string", "enum": ["confirmed"] },
                  "request_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 },
                  "message_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["outcome", "effect_certainty", "request_ref", "message_ref"],
                "properties": {
                  "outcome": { "type": "string", "enum": ["submitted"] },
                  "effect_certainty": { "type": "string", "enum": ["confirmed_submitted"] },
                  "request_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 },
                  "message_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["outcome", "effect_certainty", "request_ref", "message_ref"],
                "properties": {
                  "outcome": { "type": "string", "enum": ["rejected"] },
                  "effect_certainty": { "type": "string", "enum": ["confirmed_rejected"] },
                  "request_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 },
                  "message_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["outcome", "effect_certainty", "request_ref", "message_ref"],
                "properties": {
                  "outcome": { "type": "string", "enum": ["failed_no_effect"] },
                  "effect_certainty": { "type": "string", "enum": ["no_effect"] },
                  "request_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 },
                  "message_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["outcome", "effect_certainty", "request_ref", "message_ref"],
                "properties": {
                  "outcome": { "type": "string", "enum": ["unknown"] },
                  "effect_certainty": { "type": "string", "enum": ["unknown"] },
                  "request_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 },
                  "message_ref": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256 }
                }
              }
            ]
          }
        }
      }
    ],
    "description": "Inbox observation. Payload is typed by kind, and execution outcomes must agree with effect certainty (confirmed only with confirmed and evidence). A joined membership fact still requires baseline, scope and authoritative-evidence checks before counting; pending/unknown join states and unknown execution outcomes never count as success. PUT acceptance means durable inbox persistence only."
  },
  "ObservationReceipt": {
    "type": "object",
    "additionalProperties": false,
    "required": ["event_id", "duplicate", "apply_state", "accepted_at"],
    "properties": {
      "event_id": { "$ref": "common.json#/Id" },
      "duplicate": {
        "type": "boolean",
        "description": "True when the same event_id and digest were already accepted. It never triggers a second reducer application."
      },
      "apply_state": {
        "type": "string",
        "enum": ["queued", "applied", "failed"],
        "description": "queued is the normal 202 state; applied/failed describe the background reducer, not task success."
      },
      "accepted_at": { "$ref": "common.json#/UTCDateTime" }
    }
  },
  "ObservationEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data", "meta"],
    "properties": {
      "data": { "$ref": "#/ObservationReceipt" },
      "meta": { "$ref": "common.json#/RequestMeta" }
    }
  },
  "ObservationQueryRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workspace_id", "account_id", "target", "kind", "request_ref"],
    "properties": {
      "workspace_id": { "$ref": "common.json#/Id" },
      "account_id": { "$ref": "common.json#/Id" },
      "target": { "$ref": "common.json#/Target" },
      "kind": { "type": "string", "enum": ["membership", "join_request"] },
      "request_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 256
      }
    },
    "description": "Bounded read-only external fact query. It must never repeat the original write action."
  },
  "ObservationQueryResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query_id",
      "account_id",
      "target",
      "kind",
      "state",
      "authoritative",
      "observed_at",
      "evidence_ref",
      "snapshot_complete",
      "request_ref"
    ],
    "properties": {
      "query_id": { "$ref": "common.json#/Id" },
      "account_id": { "$ref": "common.json#/Id" },
      "target": { "$ref": "common.json#/Target" },
      "kind": { "type": "string", "enum": ["membership", "join_request"] },
      "state": {
        "type": "string",
        "enum": ["joined", "not_joined", "unknown", "pending", "approved", "rejected", "cancelled"],
        "description": "unknown is not not_joined, and pending/approved are not membership success."
      },
      "authoritative": { "type": "boolean" },
      "observed_at": { "$ref": "common.json#/UTCDateTime" },
      "evidence_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 128
      },
      "snapshot_complete": { "type": "boolean" },
      "request_ref": {
        "type": "string",
        "nullable": true,
        "minLength": 1,
        "maxLength": 256
      }
    },
    "description": "Read-only query result. Only authoritative joined membership with a complete snapshot can support a membership result; this schema does not correlate baseline/scope or create results."
  },
  "ObservationQueryEnvelope": {
